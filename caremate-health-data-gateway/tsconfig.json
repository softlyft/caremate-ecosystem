{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "paths": {
      "@caremate/common": ["libs/common/src"],
      "@caremate/common/*": ["libs/common/src/*"],
      "@caremate/supabase-client": ["libs/supabase-client/src"],
      "@caremate/supabase-client/*": ["libs/supabase-client/src/*"],
      "@caremate/encryption": ["libs/encryption/src"],
      "@caremate/encryption/*": ["libs/encryption/src/*"],
      "@caremate/profile": ["libs/profile/src"],
      "@caremate/profile/*": ["libs/profile/src/*"],
      "@caremate/emergency": ["libs/emergency/src"],
      "@caremate/emergency/*": ["libs/emergency/src/*"],
      "@caremate/mini-app-snapshots": ["libs/mini-app-snapshots/src"],
      "@caremate/mini-app-snapshots/*": ["libs/mini-app-snapshots/src/*"],
      "@caremate/family": ["libs/family/src"],
      "@caremate/family/*": ["libs/family/src/*"],
      "@caremate/messages": ["libs/messages/src"],
      "@caremate/messages/*": ["libs/messages/src/*"],
      "@caremate/documents": ["libs/documents/src"],
      "@caremate/documents/*": ["libs/documents/src/*"]
    }
  }
}
