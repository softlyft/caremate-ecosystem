PORT=3100
NODE_ENV=development

# Shared CareMate Supabase project (same as root supabase/)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# JWT secret from Supabase project settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret

# 32-byte master key (base64). Generate: openssl rand -base64 32
GATEWAY_MASTER_KEY=

# CareMate AI (Phase 1 education). Never ship these to the mobile app.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Prior-turn budgets for model context (DB fetch + prompt trim). Defaults: 16 / 8000.
# AI_HISTORY_MAX_MESSAGES=16
# AI_HISTORY_MAX_CHARS=8000
