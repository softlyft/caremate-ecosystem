{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/api/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "apps/api/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/api",
  "projects": {
    "api": {
      "type": "application",
      "root": "apps/api",
      "entryFile": "main",
      "sourceRoot": "apps/api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "supabase-client": {
      "type": "library",
      "root": "libs/supabase-client",
      "entryFile": "index",
      "sourceRoot": "libs/supabase-client/src",
      "compilerOptions": {
        "tsConfigPath": "libs/supabase-client/tsconfig.lib.json"
      }
    },
    "encryption": {
      "type": "library",
      "root": "libs/encryption",
      "entryFile": "index",
      "sourceRoot": "libs/encryption/src",
      "compilerOptions": {
        "tsConfigPath": "libs/encryption/tsconfig.lib.json"
      }
    },
    "profile": {
      "type": "library",
      "root": "libs/profile",
      "entryFile": "index",
      "sourceRoot": "libs/profile/src",
      "compilerOptions": {
        "tsConfigPath": "libs/profile/tsconfig.lib.json"
      }
    },
    "emergency": {
      "type": "library",
      "root": "libs/emergency",
      "entryFile": "index",
      "sourceRoot": "libs/emergency/src",
      "compilerOptions": {
        "tsConfigPath": "libs/emergency/tsconfig.lib.json"
      }
    }
  }
}
