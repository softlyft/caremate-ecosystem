{
  "name": "caremate-health-data-gateway",
  "version": "0.1.0",
  "description": "CareMate Health Data Gateway — NestJS trust layer for PHI encryption",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build api",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start api",
    "start:dev": "nest start api --watch",
    "start:debug": "nest start api --debug --watch",
    "start:prod": "node dist/apps/api/src/main",
    "build:lambda": "npm run build && node scripts/esbuild-lambda.mjs",
    "package:lambda": "npm run build:lambda",
    "lint": "eslint \"{apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./apps/api/test/jest-e2e.json"
  },
  "dependencies": {
    "@codegenie/serverless-express": "^4.17.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@supabase/supabase-js": "^2.50.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "express": "^5.2.1",
    "jose": "^6.2.4",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/aws-lambda": "^8.10.162",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@caremate/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@caremate/supabase-client(|/.*)$": "<rootDir>/libs/supabase-client/src/$1",
      "^@caremate/encryption(|/.*)$": "<rootDir>/libs/encryption/src/$1",
      "^@caremate/profile(|/.*)$": "<rootDir>/libs/profile/src/$1",
      "^@caremate/emergency(|/.*)$": "<rootDir>/libs/emergency/src/$1",
      "^@caremate/mini-app-snapshots(|/.*)$": "<rootDir>/libs/mini-app-snapshots/src/$1",
      "^@caremate/family(|/.*)$": "<rootDir>/libs/family/src/$1",
      "^@caremate/messages(|/.*)$": "<rootDir>/libs/messages/src/$1",
      "^@caremate/documents(|/.*)$": "<rootDir>/libs/documents/src/$1",
      "^@caremate/health-timeline(|/.*)$": "<rootDir>/libs/health-timeline/src/$1"
    }
  }
}
