INGEST_API_KEY=dev-ingest-key

# Fallback (used when env-specific vars below are empty)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Preferred: separate targets for orchestrated chain ingest (?env=dev|prod)
SUPABASE_URL_DEV=https://your-dev-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY_DEV=your-dev-service-role-key
SUPABASE_URL_PROD=https://your-prod-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY_PROD=your-prod-service-role-key

# Shared Storage for canonical sample workbooks (defaults to SUPABASE_URL above)
STORAGE_SUPABASE_URL=
STORAGE_SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=provider-ingest
STORAGE_SAMPLES_PREFIX=samples
SAMPLES_DIR=samples

# Cleaned workbooks + manifests: runs/{env}/{YYYYMMDD-HHMMSS}/
RUNS_DIR=runs

HOST=0.0.0.0
PORT=8090
