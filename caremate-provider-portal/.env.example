NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public hosts — set in Amplify/EAS or override in .env.local.
# Dev:  https://provider-dev.getcaremate.com
# Prod: https://provider.getcaremate.com
NEXT_PUBLIC_APP_URL=https://provider.getcaremate.com
NEXT_PUBLIC_WEBSITE_URL=https://getcaremate.com

# Optional — Health Data Gateway (encrypts message bodies + document titles at rest)
# HEALTH_DATA_GATEWAY_URL=https://your-gateway.execute-api.us-east-1.amazonaws.com

# Optional — structured errors go to Sentry when set
# SENTRY_DSN=https://...@....ingest.sentry.io/...
# SENTRY_ENVIRONMENT=production
