# Local machine overrides (copy to .env.local — gitignored).
# Loaded for all modes; use for localhost + secrets.

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_WEBSITE_URL=http://localhost:5175
EXPO_PUBLIC_COMMUNITY_PORTAL_URL=http://localhost:4001
EXPO_PUBLIC_PAYMENT_URL=http://localhost:5174

# Optional — leave blank to use plaintext Supabase sync only.
EXPO_PUBLIC_HEALTH_DATA_GATEWAY_URL=http://localhost:3100

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
