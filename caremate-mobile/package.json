  "devDependencies": {
    "@react-native/jest-preset": "^0.86.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.0",
    "gluestack-ui": "^5.0.3",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "prune:module-stubs": "node ./scripts/prune-nested-module-stubs.mjs",
    "start": "npm run prune:module-stubs && expo start",
    "android": "npm run prune:module-stubs && expo run:android",
    "android:apk": "npm run prune:module-stubs && cd android && SENTRY_DISABLE_AUTO_UPLOAD=true ./gradlew assembleRelease",
    "ios": "npm run prune:module-stubs && expo run:ios",
    "web": "expo start --web",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "EXPO_PUBLIC_USE_RN_FETCH=1 jest",
    "test:watch": "EXPO_PUBLIC_USE_RN_FETCH=1 jest --watchAll",
    "test:mini-apps": "jest --testPathPattern=src/mini-apps --coverage --collectCoverageFrom='src/mini-apps/**/*.{ts,tsx}' --collectCoverageFrom='!src/mini-apps/**/__tests__/**' --collectCoverageFrom='!src/mini-apps/_kit/components/**' --collectCoverageFrom='!src/mini-apps/_kit/MiniAppCard.tsx' --collectCoverageFrom='!src/mini-apps/_kit/bootstrap.ts' --collectCoverageFrom='!src/mini-apps/_kit/index.ts' --collectCoverageFrom='!src/mini-apps/test-utils.ts' --collectCoverageFrom='!src/mini-apps/**/use-*.ts' --collectCoverageFrom='!src/mini-apps/**/selectors.ts' --collectCoverageFrom='!src/mini-apps/_kit/use-persist-hydrated.ts' --collectCoverageFrom='!src/mini-apps/_kit/hydrate.ts' --collectCoverageFrom='!src/mini-apps/_kit/synced-storage.ts' --collectCoverageFrom='!src/mini-apps/_kit/snapshot-repository.ts' --coverageThreshold='{\"global\":{\"statements\":80,\"branches\":70,\"functions\":80,\"lines\":80}}'",
    "test:core": "jest --testPathPattern='src/domains/(articles|providers|emergency)' --coverage --collectCoverageFrom='src/domains/articles/**/*.{ts,tsx}' --collectCoverageFrom='src/domains/providers/**/*.{ts,tsx}' --collectCoverageFrom='src/domains/emergency/**/*.{ts,tsx}' --collectCoverageFrom='!src/domains/**/__tests__/**' --collectCoverageFrom='!src/domains/**/components/**' --collectCoverageFrom='!src/domains/**/hooks/**' --collectCoverageFrom='!src/domains/**/repository.ts' --collectCoverageFrom='!src/domains/**/index.ts' --collectCoverageFrom='!src/domains/providers/data/**' --coverageThreshold='{\"global\":{\"statements\":80,\"branches\":70,\"functions\":80,\"lines\":80}}'",
    "test:logic": "jest --coverage --collectCoverageFrom='src/domains/**/*.{ts,tsx}' --collectCoverageFrom='src/utils/**/*.{ts,tsx}' --collectCoverageFrom='src/lib/**/*.{ts,tsx}' --collectCoverageFrom='src/sync/network.ts' --collectCoverageFrom='src/features/home/**/*.{ts,tsx}' --collectCoverageFrom='!src/**/__tests__/**' --collectCoverageFrom='!src/**/*.test.ts' --collectCoverageFrom='!src/**/components/**' --collectCoverageFrom='!src/**/hooks.ts' --collectCoverageFrom='!src/**/hooks/**' --collectCoverageFrom='!src/**/repository.ts' --collectCoverageFrom='!src/**/OnboardingShell.tsx' --collectCoverageFrom='!src/domains/**/I18nProvider.tsx' --collectCoverageFrom='!src/domains/**/use-*.ts' --collectCoverageFrom='!src/domains/**/index.ts' --collectCoverageFrom='!src/domains/**/types.ts' --collectCoverageFrom='!src/domains/billing/entitlement.ts' --coverageThreshold='{\"global\":{\"statements\":80,\"branches\":70,\"functions\":80,\"lines\":80}}'",
    "db:generate": "drizzle-kit generate",
    "supabase:link": "npm run supabase:link --prefix ..",
    "supabase:migration:new": "npm run supabase:migration:new --prefix .. --",
    "supabase:db:push": "npm run supabase:db:push --prefix ..",
    "supabase:migration:list": "npm run supabase:migration:list --prefix ..",
    "eas:internal-android": "eas build --platform android --profile internal-android",
    "eas:testflight": "eas build --platform ios --profile testflight --auto-submit",
    "eas:staging": "eas build --platform all --profile staging"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.env.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/",
      "/dist/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@/assets/(.*)$": "<rootDir>/assets/$1"
    }
  },
  "private": true
}
