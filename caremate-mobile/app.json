{
  "expo": {
    "name": "CareMate",
    "slug": "caremate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/caremate-splash-icon.png",
    "scheme": "caremate",
    "userInterfaceStyle": "light",
    "owner": "softlyft",
    "ios": {
      "icon": "./assets/images/caremate-splash-icon.png",
      "bundleIdentifier": "com.softlyft.caremate",
      "associatedDomains": [
        "applinks:getcaremate.com",
        "applinks:www.getcaremate.com",
        "applinks:dev.getcaremate.com"
      ]
    },
    "android": {
      "package": "com.softlyft.caremate",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/caremate-adaptive-icon.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.POST_NOTIFICATIONS"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "https",
              "host": "getcaremate.com",
              "pathPrefix": "/auth"
            },
            {
              "scheme": "https",
              "host": "getcaremate.com",
              "pathPrefix": "/emergency/share"
            },
            {
              "scheme": "https",
              "host": "getcaremate.com",
              "pathPrefix": "/articles"
            },
            {
              "scheme": "https",
              "host": "getcaremate.com",
              "pathPrefix": "/billing"
            },
            {
              "scheme": "https",
              "host": "www.getcaremate.com",
              "pathPrefix": "/auth"
            },
            {
              "scheme": "https",
              "host": "www.getcaremate.com",
              "pathPrefix": "/emergency/share"
            },
            {
              "scheme": "https",
              "host": "www.getcaremate.com",
              "pathPrefix": "/articles"
            },
            {
              "scheme": "https",
              "host": "www.getcaremate.com",
              "pathPrefix": "/billing"
            },
            {
              "scheme": "https",
              "host": "dev.getcaremate.com",
              "pathPrefix": "/auth"
            },
            {
              "scheme": "https",
              "host": "dev.getcaremate.com",
              "pathPrefix": "/emergency/share"
            },
            {
              "scheme": "https",
              "host": "dev.getcaremate.com",
              "pathPrefix": "/articles"
            },
            {
              "scheme": "https",
              "host": "dev.getcaremate.com",
              "pathPrefix": "/billing"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true,
          "enableFTS": true
        }
      ],
      "expo-secure-store",
      "expo-background-task",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CareMate uses your location to show Nearby care providers."
        }
      ],
      "./plugins/withAndroidSplashScreenDependency.js",
      "./plugins/withRemoveSystemAlertWindow.js",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/caremate-splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        }
      },
      "eas": {
        "projectId": "de6abf70-ee13-417b-915f-9dea1066ed27"
      }
    }
  }
}
