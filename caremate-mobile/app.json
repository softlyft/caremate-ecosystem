{
  "expo": {
    "name": "CareMate",
    "slug": "caremate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/caremate-splash-icon.png",
    "scheme": "caremate",
    "userInterfaceStyle": "automatic",
    "owner": "softlyft",
    "ios": {
      "icon": "./assets/images/caremate-splash-icon.png",
      "bundleIdentifier": "com.softlyft.caremate"
    },
    "android": {
      "package": "com.softlyft.caremate",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/caremate-adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-background-task",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CareMate uses your location to show Nearby care providers."
        }
      ],
      "./plugins/withAndroidSplashScreenDependency.js",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/caremate-splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow CareMate to use Face ID for secure unlock."
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.softlyft.caremate.widgets",
          "groupIdentifier": "group.com.softlyft.caremate",
          "enableAndroid": false,
          "widgets": [
            {
              "name": "EmergencyLockWidget",
              "displayName": "Emergency Info",
              "description": "Shows blood type and ICE contact on the Lock Screen and Home Screen.",
              "contentMarginsDisabled": false,
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryCircular",
                "accessoryRectangular",
                "accessoryInline"
              ],
              "android": {
                "minWidth": 110,
                "minHeight": 40,
                "targetCellWidth": 2,
                "targetCellHeight": 1,
                "resizeMode": "horizontal"
              }
            }
          ]
        }
      ],
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.softlyft.caremate.widgets",
                  "entitlements": {
                    "com.apple.security.application-groups": ["group.com.softlyft.caremate"]
                  }
                }
              ]
            }
          }
        },
        "projectId": "de6abf70-ee13-417b-915f-9dea1066ed27"
      }
    }
  }
}
