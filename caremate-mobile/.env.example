EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Hosts — set in Amplify/EAS or override in .env.local for localhost.
# Dev:  https://dev.getcaremate.com / https://pay-dev.getcaremate.com / https://community-dev.getcaremate.com
# Prod: https://getcaremate.com / https://pay.getcaremate.com / https://community.getcaremate.com
EXPO_PUBLIC_WEBSITE_URL=https://getcaremate.com
EXPO_PUBLIC_COMMUNITY_PORTAL_URL=https://community.getcaremate.com
EXPO_PUBLIC_PAYMENT_URL=https://pay.getcaremate.com

# App environment label (Sentry / analytics). EAS profiles also set APP_ENV.
EXPO_PUBLIC_APP_ENV=development

# Sentry (crash / error monitoring). Leave blank to disable.
EXPO_PUBLIC_SENTRY_DSN=
# Set to 1 to send events from Metro / __DEV__ builds (default off).
EXPO_PUBLIC_SENTRY_ENABLE_IN_DEV=0
# Native source maps upload (EAS / CI only — never ship in the JS bundle):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=softlyft
# SENTRY_PROJECT=caremate

# PostHog (product analytics). Leave blank to disable.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Set to 1 to send events from Metro / __DEV__ builds (default off).
EXPO_PUBLIC_POSTHOG_ENABLE_IN_DEV=0

# AdMob (production). Dev builds use Google test app + banner IDs automatically.
EXPO_PUBLIC_ADMOB_APP_ID_ANDROID=ca-app-pub-3940256099942544~3347511713
EXPO_PUBLIC_ADMOB_APP_ID_IOS=ca-app-pub-3940256099942544~1458002511
EXPO_PUBLIC_ADMOB_BANNER_HOME_TIPS=ca-app-pub-3940256099942544/9214589741
EXPO_PUBLIC_ADMOB_BANNER_HOME_FEED=ca-app-pub-3940256099942544/9214589741
EXPO_PUBLIC_ADMOB_BANNER_LEARN_LIST=ca-app-pub-3940256099942544/9214589741
EXPO_PUBLIC_ADMOB_BANNER_LEARN_ARTICLE_HEADER=ca-app-pub-3940256099942544/9214589741
EXPO_PUBLIC_ADMOB_BANNER_LEARN_ARTICLE_FOOTER=ca-app-pub-3940256099942544/9214589741
EXPO_PUBLIC_ADMOB_BANNER_NEARBY_LIST=ca-app-pub-3940256099942544/9214589741
EXPO_PUBLIC_ADMOB_BANNER_NEARBY_PROVIDER=ca-app-pub-3940256099942544/9214589741
EXPO_PUBLIC_ADMOB_BANNER_PREGNANCY_TIMELINE=ca-app-pub-3940256099942544/9214589741
EXPO_PUBLIC_ADMOB_BANNER_PREGNANCY_FOOTER=ca-app-pub-3940256099942544/9214589741
EXPO_PUBLIC_ADMOB_BANNER_PERIOD_WEEK=ca-app-pub-3940256099942544/9214589741
EXPO_PUBLIC_ADMOB_BANNER_PERIOD_FOOTER=ca-app-pub-3940256099942544/9214589741
