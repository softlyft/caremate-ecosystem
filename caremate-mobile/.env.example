EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Hosts — temporary Amplify until getcaremate.com custom domains are ready.
# Later: getcaremate.com / payment.getcaremate.com / community.getcaremate.com / app.getcaremate.com / api.getcaremate.com
EXPO_PUBLIC_WEBSITE_URL=https://main.dim7uuolmjgc9.amplifyapp.com
EXPO_PUBLIC_COMMUNITY_PORTAL_URL=https://main.d2tlpjx9a9kklb.amplifyapp.com
EXPO_PUBLIC_PAYMENT_URL=https://main.d1wcqa3tsdavz8.amplifyapp.com
EXPO_PUBLIC_CARE_URL=https://main.d9xyppes84zqr.amplifyapp.com

# Store IAP product IDs (App Store Connect / Play Console). Defaults match these.
EXPO_PUBLIC_IAP_PERSONAL_MONTHLY=caremate.premium.personal.monthly
EXPO_PUBLIC_IAP_PERSONAL_YEARLY=caremate.premium.personal.yearly
EXPO_PUBLIC_IAP_FAMILY_MONTHLY=caremate.premium.family.monthly
EXPO_PUBLIC_IAP_FAMILY_YEARLY=caremate.premium.family.yearly

# Optional Health Data Gateway (Nest/Lambda). Leave blank to sync profile/emergency
# as plaintext to Supabase. When set, mobile prefers the gateway and falls back
# to plaintext Supabase if the gateway is down or errors.
# Local: http://localhost:3100
# Deployed DEV: https://2pssx73li6.execute-api.us-east-1.amazonaws.com
# Production: https://api.getcaremate.com
EXPO_PUBLIC_HEALTH_DATA_GATEWAY_URL=https://2pssx73li6.execute-api.us-east-1.amazonaws.com

# App environment label (Sentry / analytics). EAS profiles also set APP_ENV.
EXPO_PUBLIC_APP_ENV=development

# Sentry (crash / error monitoring). Leave blank to disable.
EXPO_PUBLIC_SENTRY_DSN=
# Set to 1 to send events from Metro / __DEV__ builds (default off).
EXPO_PUBLIC_SENTRY_ENABLE_IN_DEV=0
# Native source maps upload (EAS / CI only — never ship in the JS bundle):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=softlyft
# SENTRY_PROJECT=caremate

# PostHog (product analytics). Leave blank to disable.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Set to 1 to send events from Metro / __DEV__ builds (default off).
EXPO_PUBLIC_POSTHOG_ENABLE_IN_DEV=0

# AdMob (production secrets — used only when EXPO_PUBLIC_APP_ENV=production).
# Metro / main TestFlight / sideload APK always use Google sample app + banner IDs.
EXPO_PUBLIC_ADMOB_APP_ID_ANDROID=ca-app-pub-3940256099942544~3347511713
EXPO_PUBLIC_ADMOB_APP_ID_IOS=ca-app-pub-3940256099942544~1458002511
# iOS: one banner unit for every slot. Android: paste the Android banner unit into all 11 below.
EXPO_PUBLIC_ADMOB_BANNER_UNIT_IOS=ca-app-pub-3940256099942544/2934735716
EXPO_PUBLIC_ADMOB_BANNER_HOME_TIPS=ca-app-pub-3940256099942544/9214589741
EXPO_PUBLIC_ADMOB_BANNER_HOME_FEED=ca-app-pub-3940256099942544/9214589741
EXPO_PUBLIC_ADMOB_BANNER_LEARN_LIST=ca-app-pub-3940256099942544/9214589741
EXPO_PUBLIC_ADMOB_BANNER_LEARN_ARTICLE_HEADER=ca-app-pub-3940256099942544/9214589741
EXPO_PUBLIC_ADMOB_BANNER_LEARN_ARTICLE_FOOTER=ca-app-pub-3940256099942544/9214589741
EXPO_PUBLIC_ADMOB_BANNER_NEARBY_LIST=ca-app-pub-3940256099942544/9214589741
EXPO_PUBLIC_ADMOB_BANNER_NEARBY_PROVIDER=ca-app-pub-3940256099942544/9214589741
EXPO_PUBLIC_ADMOB_BANNER_PREGNANCY_TIMELINE=ca-app-pub-3940256099942544/9214589741
EXPO_PUBLIC_ADMOB_BANNER_PREGNANCY_FOOTER=ca-app-pub-3940256099942544/9214589741
EXPO_PUBLIC_ADMOB_BANNER_PERIOD_WEEK=ca-app-pub-3940256099942544/9214589741
EXPO_PUBLIC_ADMOB_BANNER_PERIOD_FOOTER=ca-app-pub-3940256099942544/9214589741
