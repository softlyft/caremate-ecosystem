{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_WEBSITE_URL": "https://dev.getcaremate.com",
        "EXPO_PUBLIC_COMMUNITY_PORTAL_URL": "https://community-dev.getcaremate.com",
        "EXPO_PUBLIC_PAYMENT_URL": "https://pay-dev.getcaremate.com"
      }
    },
    "internal-android": {
      "android": {
        "buildType": "apk",
        "distribution": "internal"
      },
      "channel": "internal",
      "env": {
        "APP_ENV": "internal",
        "EXPO_PUBLIC_APP_ENV": "internal",
        "EXPO_PUBLIC_WEBSITE_URL": "https://dev.getcaremate.com",
        "EXPO_PUBLIC_COMMUNITY_PORTAL_URL": "https://community-dev.getcaremate.com",
        "EXPO_PUBLIC_PAYMENT_URL": "https://pay-dev.getcaremate.com"
      }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "autoIncrement": true,
      "env": {
        "APP_ENV": "staging",
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_WEBSITE_URL": "https://dev.getcaremate.com",
        "EXPO_PUBLIC_COMMUNITY_PORTAL_URL": "https://community-dev.getcaremate.com",
        "EXPO_PUBLIC_PAYMENT_URL": "https://pay-dev.getcaremate.com"
      }
    },
    "testflight": {
      "ios": {
        "distribution": "store",
        "autoIncrement": true
      },
      "channel": "testflight",
      "env": {
        "APP_ENV": "testflight",
        "EXPO_PUBLIC_APP_ENV": "testflight",
        "EXPO_PUBLIC_WEBSITE_URL": "https://getcaremate.com",
        "EXPO_PUBLIC_COMMUNITY_PORTAL_URL": "https://community.getcaremate.com",
        "EXPO_PUBLIC_PAYMENT_URL": "https://pay.getcaremate.com"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_WEBSITE_URL": "https://getcaremate.com",
        "EXPO_PUBLIC_COMMUNITY_PORTAL_URL": "https://community.getcaremate.com",
        "EXPO_PUBLIC_PAYMENT_URL": "https://pay.getcaremate.com"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID"
      }
    }
  }
}
