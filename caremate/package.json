  "dependencies": {
    "@caremate/db-types": "*",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/html-elements": "^57.0.0",
    "@expo/ui": "~57.0.4",
    "@gluestack-ui/core": "^5.0.15",
    "@gluestack-ui/utils": "^5.0.6",
    "@hookform/resolvers": "^5.4.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.110.5",
    "@tanstack/react-query": "^5.101.2",
    "drizzle-orm": "^0.45.1",
    "emergency-lock-widget": "file:modules/emergency-lock-widget",
    "expo": "~57.0.4",
    "expo-background-task": "~57.0.2",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.0",
    "expo-device": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-glass-effect": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-linking": "~57.0.2",
    "expo-local-authentication": "~57.0.0",
    "expo-network": "~57.0.0",
    "expo-router": "~57.0.4",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.2",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-symbols": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-task-manager": "~57.0.2",
    "expo-web-browser": "~57.0.0",
    "expo-widgets": "~57.0.3",
    "lucide-react-native": "^1.24.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.81.0",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "tailwindcss": "^4.3.2",
    "uniwind": "^1.10.0",
    "uuid": "^13.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.0",
    "gluestack-ui": "^5.0.3",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "db:generate": "drizzle-kit generate",
    "supabase:link": "npm run supabase:link --prefix ..",
    "supabase:migration:new": "npm run supabase:migration:new --prefix .. --",
    "supabase:db:push": "npm run supabase:db:push --prefix ..",
    "supabase:migration:list": "npm run supabase:migration:list --prefix ..",
    "eas:internal-android": "eas build --platform android --profile internal-android",
    "eas:testflight": "eas build --platform ios --profile testflight --auto-submit",
    "eas:staging": "eas build --platform all --profile staging"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/ios/",
      "/dist/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@/assets/(.*)$": "<rootDir>/assets/$1"
    }
  },
  "private": true
}
