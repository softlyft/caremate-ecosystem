NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Provider ingest engine (FastAPI at repo root / caremate-provider-ingestion)
PROVIDER_INGEST_URL=http://127.0.0.1:8090
PROVIDER_INGEST_API_KEY=dev-ingest-key

# Paystack / Stripe secrets are NOT used by the portal runtime.
# Configure them on Supabase Edge Functions instead:
#   supabase secrets set STRIPE_SECRET_KEY=... STRIPE_WEBHOOK_SECRET=... PAYSTACK_SECRET_KEY=...
